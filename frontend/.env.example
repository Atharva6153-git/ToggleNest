# Base URL of the backend API, including the /api suffix.
# Defaults to http://localhost:5000/api when unset (local development).
VITE_API_URL=http://localhost:5000/api

# Firebase Web SDK configuration.
# These values are safe to expose to the browser, but keep them in env files so
# deployments can point at different Firebase projects without code changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
