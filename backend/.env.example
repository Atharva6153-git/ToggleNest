MONGO_URI=your_mongo_connection_string_here
PORT=5000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
# Production frontend origin(s) for CORS. http://localhost:5173 / http://127.0.0.1:5173
# are always allowed for local dev. Comma-separate if you have more than one frontend URL.
FRONTEND_URL=https://your-production-frontend.example.com
# Firebase Admin SDK credentials - use ONE of the two options below:
# Option A (recommended for hosted platforms where you cannot upload a file):
#   the service account JSON as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"..."}
# Option B: path to a service account JSON file (gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Download the Firebase service account JSON from:
# Firebase Console > Project Settings (gear icon) > Service accounts > Generate new private key
# Save it locally as backend/serviceAccountKey.json (never commit it to git).