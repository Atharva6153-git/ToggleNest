# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Set to true when running behind a reverse proxy / load balancer (Render,
# Railway, Fly.io, Heroku, nginx). Required so client IPs and HTTPS detection work.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database + authentication
# ---------------------------------------------------------------------------
MONGO_URI=your_mongo_connection_string_here
# Must be at least 32 random characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=togglenest
JWT_AUDIENCE=togglenest-web
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Production frontend origin(s) for CORS. http://localhost:5173 and
# http://127.0.0.1:5173 are always allowed outside production.
# Comma-separate if you have more than one frontend URL.
FRONTEND_URL=https://your-production-frontend.example.com

# ---------------------------------------------------------------------------
# Session cookies + CSRF (double-submit)
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=tn_session
CSRF_COOKIE_NAME=tn_csrf
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
# lax | strict | none. Use "none" only when the frontend is on a different
# site than the API; it requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Rate limiting + spend caps
# ---------------------------------------------------------------------------
# Requests per 15 minutes per IP.
GLOBAL_RATE_LIMIT=2000
# Failed login/register attempts per 15 minutes per IP.
AUTH_RATE_LIMIT=10
# Uploads per hour per IP.
UPLOAD_RATE_LIMIT=10
# Uploads per user per day (application-side spend cap).
UPLOAD_DAILY_LIMIT=20

# ---------------------------------------------------------------------------
# API docs (never exposed in production unless explicitly enabled for admins)
# ---------------------------------------------------------------------------
ENABLE_SWAGGER=false

# Return a bearer JWT in the login response body. Browsers use the httpOnly
# session cookie, so this defaults to false in production. Enable only for
# trusted non-browser API clients.
RETURN_TOKEN_IN_BODY=false

# ---------------------------------------------------------------------------
# Firebase Admin SDK credentials - use ONE of the two options below
# ---------------------------------------------------------------------------
# Option A (recommended for hosted platforms where you cannot upload a file):
#   the service account JSON as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"..."}
# Option B: path to a service account JSON file (gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Download the Firebase service account JSON from:
# Firebase Console > Project Settings (gear icon) > Service accounts > Generate new private key
# Save it locally as backend/serviceAccountKey.json (never commit it to git).

# ---------------------------------------------------------------------------
# Cloudinary (profile picture uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
